cabal-version: 3.8
name:          reckon
version:       0.1.0.0
synopsis:      A personal double-entry ledger that reconciles to the cent against real bank statements
license:       NONE
build-type:    Simple

-- Settings shared by every component below.
common shared
  default-language:   GHC2024
  default-extensions:
    DuplicateRecordFields
    OverloadedRecordDot
    OverloadedStrings

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-deriving-strategies
    -Wpartial-fields -Wredundant-constraints -Wunused-packages

  build-depends:      base >=4.20 && <5

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Reckon.Anthropic
    Reckon.Api
    Reckon.Api.JsonOptions
    Reckon.Api.Types
    Reckon.Api.TypeScript
    Reckon.App
    Reckon.Bank
    Reckon.Config
    Reckon.Database
    Reckon.Database.Schema
    Reckon.Import
    Reckon.Import.Dedupe
    Reckon.Import.RbcCsv
    Reckon.Ledger
    Reckon.Ledger.AccountType
    Reckon.Ledger.Entry
    Reckon.Messages
    Reckon.Money
    Reckon.People
    Reckon.Posting
    Reckon.Posting.Classify
    Reckon.Posting.Split
    Reckon.Reconcile
    Reckon.Reconcile.Explain
    Reckon.Report
    Reckon.Screenshot.Align
    Reckon.Screenshot.Eval
    Reckon.Screenshot.Extraction
    Reckon.Screenshot.Import
    Reckon.Screenshot.Match
    Reckon.Screenshot.Resolution
    Reckon.Screenshot.Score
    Reckon.Screenshot.Store
    Reckon.Security
    Reckon.Server
    Reckon.Sharing
    Reckon.Views

  other-modules:   Paths_reckon
  autogen-modules: Paths_reckon
  build-depends:
    , aeson
    , aeson-typescript
    , base16-bytestring
    , base64-bytestring
    , bytestring
    , case-insensitive
    , cassava
    , containers
    , cryptohash-sha256
    , directory
    , esqueleto
    , filepath
    , http-client
    , http-client-tls
    , http-types
    , monad-logger
    , mtl
    , persistent
    , persistent-postgresql
    , servant
    , servant-server
    , text
    , time
    , unliftio
    , vector
    , wai

-- The HTTP server. `make dev` runs this.
executable reckon-server
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    , reckon
    , text
    , wai-extra
    , warp

-- Command-line tools (importing a CSV). `make import file=...` runs this.
executable reckon-cli
  import:         shared
  hs-source-dirs: cli
  main-is:        Main.hs
  build-depends:
    , bytestring
    , filepath
    , persistent
    , reckon
    , text
    , time

-- Writes the TypeScript API types for the frontend. `make codegen` runs this.
executable reckon-codegen
  import:         shared
  hs-source-dirs: codegen
  main-is:        Main.hs
  build-depends:
    , reckon
    , text

test-suite reckon-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  other-modules:
    Reckon.AnthropicSpec
    Reckon.ApiSpec
    Reckon.Api.TypesSpec
    Reckon.ConfigSpec
    Reckon.Import.DedupeSpec
    Reckon.Import.RbcCsvSpec
    Reckon.ImportSpec
    Reckon.Ledger.EntrySpec
    Reckon.LedgerSpec
    Reckon.Posting.ClassifySpec
    Reckon.Posting.SplitSpec
    Reckon.PostingSpec
    Reckon.Reconcile.ExplainSpec
    Reckon.ScenarioSupport
    Reckon.ScreenshotSpec
    Reckon.Screenshot.AlignSpec
    Reckon.Screenshot.ExtractionSpec
    Reckon.Screenshot.MatchSpec
    Reckon.Screenshot.ScoreSpec
    Reckon.SharingSpec
    Reckon.ServerSpec
    Reckon.TestSupport

  ghc-options:    -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    , aeson
    , base64-bytestring
    , bytestring
    , containers
    , hedgehog
    , hspec
    , hspec-hedgehog
    , hspec-wai
    , http-client
    , http-types
    , persistent
    , reckon
    , text
    , time
    , wai
    , wai-extra
    , warp
