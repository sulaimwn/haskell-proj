# Local development settings. `make dev` copies this to .env (gitignored) if
# .env doesn't exist yet. Put secrets in .env, never in this file.

# Host port for the Postgres container. 5433 avoids clashing with a Postgres
# you may already have installed on 5432.
RECKON_DB_PORT=5433

DATABASE_URL=postgres://reckon:reckon@localhost:5433/reckon?sslmode=disable
TEST_DATABASE_URL=postgres://reckon:reckon@localhost:5433/reckon_test?sslmode=disable

# Port the Haskell API listens on. The Vite dev server proxies /api here.
RECKON_PORT=8080

# Phase 5 (screenshot import) will read these. Leave empty until then.
# ANTHROPIC_API_KEY=
