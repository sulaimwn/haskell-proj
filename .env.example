# Local development settings. `make dev` copies this to .env (gitignored) if
# .env doesn't exist yet. Put secrets in .env, never in this file.

# Host port for the Postgres container. 5433 avoids clashing with a Postgres
# you may already have installed on 5432.
RECKON_DB_PORT=5433

DATABASE_URL=postgres://reckon:reckon@localhost:5433/reckon?sslmode=disable
TEST_DATABASE_URL=postgres://reckon:reckon@localhost:5433/reckon_test?sslmode=disable

# Port the Haskell API listens on. The Vite dev server proxies /api here.
RECKON_PORT=8080

# The API has no login, so it only listens on this machine (Phase 6, D061).
# Leave these alone unless you know why: widening them exposes your ledger.
# RECKON_HOST=127.0.0.1
# Host names the API will answer to (a defence against DNS rebinding).
# RECKON_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Screenshot import (Phase 5). Put your real key in .env (never in this
# file). Only the backend reads it. Leave it unset to work without screenshots.
# ANTHROPIC_API_KEY=
# Which Claude model reads the screenshots. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
